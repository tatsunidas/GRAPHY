	<licenses>
		<license>
			<name>The Mozilla Public License, Version 1.1 </name>
	    	<url>https://www.mozilla.org/media/MPL/1.1/index.0c5913925d40.txt</url>
	  	</license>
	</licenses>
	
	<developers>
		<developer>
      		<name>Tatsuaki Kobayashi</name>
      		<email>t_kobayashi@vis-ionary.com</email>
      		<organization>Visionry Imaging Services, Inc.</organization>
      		<organizationUrl>https://www.vis-ionary.com</organizationUrl>
    	</developer>
	</developers>

	<properties>
		<exec.mainClass>com.vis.core.launcher.Launcher</exec.mainClass>
		<java.version>11</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<imagej-version>1.54f</imagej-version>
		<dcm4che-version>5.23.2</dcm4che-version>
		<derby-version>10.14.2.0</derby-version>
		<pdfbox-version>2.0.12</pdfbox-version>
		<apache-commons-io-version>2.13.0</apache-commons-io-version>
		<radiance-substance-version>4.5.0</radiance-substance-version>
		<joml-version>1.10.5</joml-version>
		<asm-version>9.5</asm-version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<release>${java.version}</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<mainClass>com.vis.core.launcher.Launcher</mainClass>
							<classpathPrefix>lib/</classpathPrefix>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<!-- copy run scripts -->
					<execution>
						<id>copy-scripts</id>
                     <phase>package</phase>
                     <goals>
						 	<goal>copy-resources</goal>
                     </goals>
                     <configuration>
                         <outputDirectory>${project.build.directory}</outputDirectory>
                         <resources>
                             <resource>
                                 <directory>src/main/scripts</directory>
                                 <filtering>true</filtering>
                             </resource>
                         </resources>
                     </configuration>
                  </execution>
                  <!-- copy native libs -->
					<execution>
						<id>copy-native-libs</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<resources>
								<resource>
									<directory>./native</directory>
									<includes>
										<include>**/*</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<!-- copy luts -->
					<execution>
						<id>copy-luts</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/luts</outputDirectory>
							<resources>
								<resource>
									<directory>./luts</directory>
									<includes>
										<include>**/*</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			
			<!-- add chmod to start app from sh for Unix(linux/mac) -->
			<plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version> <executions>
                    <execution>
                        <id>chmod-script</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <condition property="isUnix">
                                    <os family="unix"/>
                                </condition>
                                <chmod file="${project.build.directory}/run.sh" perm="ugo+x"
                                       if="isUnix"/>
                                </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-dependency-plugin</artifactId>
			    <version>3.6.0</version> <executions>
			        <execution>
			            <id>copy-dependencies</id>
			            <phase>package</phase>
			            <goals>
			                <goal>copy-dependencies</goal>
			            </goals>
			            <configuration>
			                <outputDirectory>${project.build.directory}/jars</outputDirectory> <overWriteReleases>false</overWriteReleases>
			                <overWriteSnapshots>false</overWriteSnapshots>
			                <overWriteIfNewer>true</overWriteIfNewer>
			            </configuration>
			        </execution>
			    </executions>
			</plugin>
		</plugins>
		<resources>
			<!-- for application.properties -->
       	<resource>
          		<directory>src/main/resources</directory>
            	<filtering>true</filtering>
            	<includes>
                	<include>**/*.properties</include>
            	</includes>
        	</resource>
	        <!-- others -->
    	   	<resource>
          		<directory>src/main/resources</directory>
            	<filtering>false</filtering>
            	<includes>
              	<include>**/*</include> <!-- all files -->
            	</includes>
            	<excludes>
              	<exclude>**/*.properties</exclude>
            	</excludes>
        	</resource>
		</resources>
	</build>

