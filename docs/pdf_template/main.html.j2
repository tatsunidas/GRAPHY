{%- extends "base.html.j2" %}

{% block styles %}
{{ super() }}
<style>
  /* PDF-specific overrides */
  body {
    font-family: "Noto Sans CJK JP", "IPAGothic", "Hiragino Kaku Gothic Pro", sans-serif;
    font-size: 10pt;
    line-height: 1.6;
  }

  h1 { font-size: 18pt; margin-top: 0; }
  h2 { font-size: 14pt; break-before: page; }
  h3 { font-size: 12pt; }
  h4 { font-size: 10pt; }

  /* Suppress page break on h2 if it immediately follows h1 */
  h1 + h2 { break-before: avoid; }

  /* Tables */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
    font-size: 9pt;
  }
  th {
    background-color: #3f51b5;
    color: white;
    padding: 6px 8px;
    text-align: left;
  }
  td {
    padding: 5px 8px;
    border-bottom: 1px solid #ddd;
  }
  tr:nth-child(even) td { background-color: #f5f5f5; }

  /* Code blocks */
  pre, code {
    font-family: "Courier New", monospace;
    font-size: 8pt;
    background: #f8f8f8;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
  }
  pre { padding: 8px; overflow-x: auto; }

  /* Admonitions */
  .admonition {
    border-left: 4px solid #3f51b5;
    padding: 8px 12px;
    margin: 10px 0;
    background: #e8eaf6;
    break-inside: avoid;
  }
  .admonition.warning { border-color: #f57c00; background: #fff3e0; }
  .admonition.tip    { border-color: #388e3c; background: #e8f5e9; }
  .admonition.note   { border-color: #0288d1; background: #e1f5fe; }

  /* Images */
  img {
    max-width: 100%;
    border: 1px solid #ccc;
    border-radius: 3px;
  }

  /* Manual page break */
  .new-page { break-before: page; }
</style>
{% endblock %}
